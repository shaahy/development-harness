    {"name":"ui_review_pass","from":"UI_REVIEW","event":"UI_REVIEW_PASSED","expected_to":"PLAN_GENERATING","expected_action":"dispatch_planner_with_generated_ui"},
    {"name":"plan_generated","from":"PLAN_GENERATING","event":"PLAN_GENERATED","expected_to":"PLAN_REVIEW","expected_action":"dispatch_plan_reviewer"},
