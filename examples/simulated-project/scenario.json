    {"name":"fix_to_retest","from":"TASK_REWORK","event":"FIX_DONE","expected_to":"TASK_TESTING","expected_action":"dispatch_tester"},
    {"name":"test_pass_to_review","from":"TASK_TESTING","event":"TEST_PASSED","expected_to":"TASK_REVIEW","expected_action":"dispatch_reviewer"},
